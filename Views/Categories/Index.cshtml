@model List<BIT240219_Mid.Models.DishCategory_BIT240219>
@{ViewData["Title"]="Categories";}
<div class="subhero"><div class="eyebrow" data-i18n="menuOrganization">MENU ORGANIZATION</div><h1 data-i18n="categoryTitle">Good food starts<br/>with <em>good company.</em></h1><p data-i18n="categorySub">Keep your menu thoughtfully organized.</p></div>@if(TempData["Error"]!=null){<div class="notice">@TempData["Error"]</div>}<div class="category-layout"><section class="category-list">@foreach(var c in Model){<article class="category-card card"><div><span class="category-icon">✳</span><div><h2 data-seed-name>@c.Name</h2><p>@(c.Description??"No description")</p></div></div><div class="category-end"><span>@c.Dishes.Count <span data-i18n="dishes">dishes</span></span><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@c.Id"/><button class="small-action danger" data-i18n="delete">Delete</button></form></div></article>}</section><form asp-action="Create" method="post" class="card category-form"><h2 data-i18n="newCategory">Add a category</h2><p data-i18n="newCategorySub">Create a home for your next favorite.</p><label><span data-i18n="categoryName">CATEGORY NAME</span><input name="name" required maxlength="80"/></label><label><span data-i18n="description">DESCRIPTION</span><textarea name="description" rows="3"></textarea></label><button class="button primary" data-i18n="createCategory">Create category →</button></form></div>
