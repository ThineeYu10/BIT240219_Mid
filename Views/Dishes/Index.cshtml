@model BIT240219_Mid.Models.DishListViewModel
@{ ViewData["Title"]="Dishes"; }
<section class="hero"><div><div class="eyebrow" data-i18n="overview">MENU OVERVIEW</div><h1 data-i18n="pageTitle">A menu made<br/>with <em>intention.</em></h1><p data-i18n="pageSub">Manage your kitchen's dishes, availability and details.</p></div><a class="button primary" asp-action="Create"><span>＋</span> <span data-i18n="addDish">Add a dish</span></a></section>
<section class="stats"><article><span data-i18n="totalDishes">TOTAL DISHES</span><strong>@Model.Dishes.Count</strong><small data-i18n="inView">in this view</small></article><article><span data-i18n="categories">CATEGORIES</span><strong>@Model.Categories.Count.ToString("00")</strong><small data-i18n="curatedGroups">curated groups</small></article><article><span data-i18n="availableNow">AVAILABLE NOW</span><strong>@Model.Dishes.Count(d=>d.IsAvailable).ToString("00")</strong><small data-i18n="readyToServe">ready to serve</small></article></section>
<form method="get" class="filters card"><div class="filter-title"><div><h2 data-i18n="findDish">Find a dish</h2><span data-i18n="refineMenu">Refine your menu with a few filters</span></div><a asp-action="Index" class="clear" data-i18n="clearAll">Clear all</a></div><div class="filter-grid"><label><span data-i18n="search">SEARCH</span><input name="search" value="@Model.Search" placeholder="Dish name..." data-placeholder-en="Dish name..." data-placeholder-vi="Tên món ăn..."/></label><label><span data-i18n="category">CATEGORY</span><select name="categoryId"><option value="" data-i18n="allCategories">All categories</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId==c.Id)" data-seed-name>@c.Name</option>}</select></label><label><span data-i18n="availability">AVAILABILITY</span><select name="availability"><option value="" data-i18n="allStatus">All status</option><option value="available" selected="@(Model.Availability=="available")" data-i18n="available">Available</option><option value="unavailable" selected="@(Model.Availability=="unavailable")" data-i18n="unavailable">Unavailable</option></select></label><label><span data-i18n="priceFrom">PRICE FROM</span><input name="minPrice" type="number" step="0.01" min="0" value="@Model.MinPrice" placeholder="$ Min" data-placeholder-en="$ Min" data-placeholder-vi="Tối thiểu"/></label><label><span data-i18n="priceTo">PRICE TO</span><input name="maxPrice" type="number" step="0.01" min="0" value="@Model.MaxPrice" placeholder="$ Max" data-placeholder-en="$ Max" data-placeholder-vi="Tối đa"/></label><label><span data-i18n="sortBy">SORT BY</span><select name="sort"><option value="" data-i18n="nameAZ">Name A–Z</option><option value="price-asc" selected="@(Model.Sort=="price-asc")" data-i18n="priceLow">Price: low to high</option><option value="price-desc" selected="@(Model.Sort=="price-desc")" data-i18n="priceHigh">Price: high to low</option><option value="time-asc" selected="@(Model.Sort=="time-asc")" data-i18n="quickest">Preparation: quickest</option></select></label></div><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="filter-actions"><span>@Model.Dishes.Count <span data-i18n="results">results</span></span><button class="button dark" data-i18n="applyFilters">Apply filters</button></div></form>
<section class="list-heading"><div><h2 data-i18n="yourDishes">Your dishes</h2><span data-i18n="menuCollection">A considered collection for today's menu</span></div><a asp-controller="Categories" asp-action="Index" class="text-link" data-i18n="manageCategories">Manage categories ↗</a></section>
@if(Model.Dishes.Count==0){<div class="empty card"><div>⌕</div><h3 data-i18n="noResults">No dishes found</h3><p data-i18n="adjustFilters">Try adjusting your search or filters.</p></div>}else{<div class="dish-grid">@foreach(var d in Model.Dishes){var im=d.Images.FirstOrDefault(x=>x.IsThumbnail)??d.Images.FirstOrDefault();<article class="dish-card"><a asp-action="Details" asp-route-id="@d.Id" class="dish-photo">@if(im!=null){<img src="@im.ImageUrl" alt="@d.Name"/>}else{<div class="photo-empty">S</div>}<span class="availability @(d.IsAvailable?"on":"off")" data-i18n="@(d.IsAvailable?"available":"unavailable")">@(d.IsAvailable?"Available":"Unavailable")</span></a><div class="dish-info"><div class="dish-meta"><span data-seed-name>@d.DishCategory?.Name</span><span>@(d.PreparationTime<=15?"⚡":"◷") @(d.PreparationTime<=15?"Quick":"Regular") · @d.PreparationTime min</span></div><a asp-action="Details" asp-route-id="@d.Id" class="dish-name" data-seed-name>@d.Name</a><p>@d.Description</p><div class="dish-bottom"><strong>$@d.Price.ToString("0.00")</strong><a asp-action="Edit" asp-route-id="@d.Id" data-i18n="edit">Edit ↗</a></div></div></article>}</div>}
