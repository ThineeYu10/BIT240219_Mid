@model BIT240219_Mid.Models.Dish_BIT240219
<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><label class="wide"><span data-i18n="dishName">DISH NAME</span><input asp-for="Name" placeholder="e.g. Roasted tomato pasta"/><span asp-validation-for="Name" class="field-error"></span></label><label><span data-i18n="category">CATEGORY</span><select asp-for="DishCategoryId" asp-items="ViewBag.Categories"><option value="" data-i18n="selectCategory">Select a category</option></select><span asp-validation-for="DishCategoryId" class="field-error"></span></label><label><span data-i18n="price">PRICE · USD</span><input asp-for="Price" type="number" step="0.01" min="0.01"/><span asp-validation-for="Price" class="field-error"></span></label><label><span data-i18n="prepTime">PREPARATION TIME · MINUTES</span><input asp-for="PreparationTime" type="number" min="1"/><span asp-validation-for="PreparationTime" class="field-error"></span></label><label class="check-row"><input asp-for="IsAvailable"/><span data-i18n="availableForOrder">Available for order</span></label><label class="wide"><span data-i18n="description">DESCRIPTION</span><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description" class="field-error"></span></label></div>
