@model BIT240219_Mid.Models.Dish_BIT240219
@{ViewData["Title"]=Model.Name; var thumb=Model.Images.FirstOrDefault(x=>x.IsThumbnail)??Model.Images.FirstOrDefault();}
<a asp-action="Index" class="back" data-i18n="backMenu">← Back to menu</a><div class="detail-head"><div><div class="eyebrow"><span data-seed-name>@Model.DishCategory?.Name</span> · <span data-i18n="dishDetails">DISH DETAILS</span></div><h1 data-seed-name>@Model.Name</h1></div><a class="button primary" asp-action="Edit" asp-route-id="@Model.Id" data-i18n="editDish">Edit dish ↗</a></div><section class="detail-layout"><div class="detail-main">@if(thumb!=null){<img class="detail-cover" src="@thumb.ImageUrl" alt="@Model.Name"/>}else{<div class="detail-cover photo-empty">S</div>}<div class="detail-copy"><h2 data-i18n="aboutDish">About this dish</h2><p>@Model.Description</p></div><div class="gallery-head"><div><h2 data-i18n="gallery">Dish gallery</h2><span data-i18n="gallerySub">Add and curate dish photography</span></div><span>@Model.Images.Count <span data-i18n="photos">photos</span></span></div><div class="gallery">@foreach(var img in Model.Images){<article><img src="@img.ImageUrl" alt="@Model.Name"/><div>@if(img.IsThumbnail){<span class="thumb-badge" data-i18n="coverPhoto">Cover photo</span>}else{<form asp-action="SetThumbnail" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="imageId" value="@img.Id"/><button class="small-action" data-i18n="makeCover">Make cover</button></form>}<form asp-action="DeleteImage" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="imageId" value="@img.Id"/><button class="small-action danger" data-i18n="remove">Remove</button></form></div></article>}</div><form asp-action="AddImage" method="post" class="add-image card"><input type="hidden" name="id" value="@Model.Id"/><label><span data-i18n="addImage">ADD IMAGE BY URL</span><input name="imageUrl" required type="url" placeholder="https://..."/></label><button class="button dark" data-i18n="addImageBtn">＋ Add image</button></form>@if(TempData["Error"]!=null){<p class="field-error">@TempData["Error"]</p>}</div><aside class="detail-side card"><div class="status-line"><span data-i18n="availability">AVAILABILITY</span><span class="availability @(Model.IsAvailable?"on":"off")" data-i18n="@(Model.IsAvailable?"available":"unavailable")">@(Model.IsAvailable?"Available":"Unavailable")</span></div><div class="side-row"><span data-i18n="price">PRICE</span><strong>$@Model.Price.ToString("0.00")</strong></div><div class="side-row"><span data-i18n="prepTime">PREPARATION TIME</span><strong>@Model.PreparationTime min</strong></div><div class="side-row"><span data-i18n="pace">PACE</span><strong data-i18n="@(Model.PreparationTime<=15?"quick":"regular")">@(Model.PreparationTime<=15?"Quick / Nhanh":"Regular / Thông thường")</strong></div><div class="side-row"><span data-i18n="category">CATEGORY</span><strong data-seed-name>@Model.DishCategory?.Name</strong></div></aside></section>
